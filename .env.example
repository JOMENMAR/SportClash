# Copia este archivo como .env y rellena los valores
# Nota: en Vite las variables deben empezar por VITE_

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Backend AWS (REST)
# Ej: https://xxxx.execute-api.eu-west-1.amazonaws.com/dev
VITE_AWS_API_BASE_URL=

# Backend AWS (WebSocket)
# Ej: wss://xxxx.execute-api.eu-west-1.amazonaws.com/dev
VITE_AWS_WS_URL=
