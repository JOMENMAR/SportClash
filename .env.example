# Copia este archivo como .env y rellena los valores
# Nota: en Vite las variables deben empezar por VITE_

# Backend AWS (REST)
# Ej: https://xxxx.execute-api.eu-west-1.amazonaws.com/dev
VITE_AWS_API_BASE_URL=

# (Opcional) Target para el proxy de Vite en DEV cuando no hay VITE_AWS_API_BASE_URL.
# El frontend usará `/api` y Vite lo reenviará a este target.
# Ej: http://localhost:3000
VITE_AWS_API_PROXY_TARGET=

# Backend AWS (WebSocket)
# Ej: wss://xxxx.execute-api.eu-west-1.amazonaws.com/dev
VITE_AWS_WS_URL=

# Cognito Hosted UI (valores públicos, NO secretos)
# Ej dominio: https://tu-dominio.auth.eu-west-1.amazoncognito.com
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=

# Normalmente el redirect/logout debe ser exactamente tu URL (debe estar permitida en Cognito).
# Ej: http://localhost:5173
VITE_COGNITO_REDIRECT_URI=
VITE_COGNITO_LOGOUT_URI=

# Por defecto: openid email profile
VITE_COGNITO_SCOPES=openid email profile

# (Opcional) IdP para botones sociales en la UI de SportClash.
# Usa exactamente el nombre del proveedor en Cognito (Identity providers).
# Ejemplos comunes: Google, Microsoft, Discord
VITE_COGNITO_IDP_MICROSOFT=
VITE_COGNITO_IDP_MICROSOFT_SCOPES=
VITE_COGNITO_IDP_GOOGLE=
VITE_COGNITO_IDP_GOOGLE_SCOPES=
VITE_COGNITO_IDP_FACEBOOK=
VITE_COGNITO_IDP_FACEBOOK_SCOPES=
VITE_COGNITO_IDP_DISCORD=
VITE_COGNITO_IDP_DISCORD_SCOPES=

# Alternativa a .env: también puedes editar `public/runtime-config.js` en el hosting
# para cambiar endpoints sin recompilar el frontend.
